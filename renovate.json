{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "constraints": {
    "python": ">=3.11"
  },
  "constraintsFiltering": "strict",
  "packageRules": [
    {
      "matchPackageNames": [
        "/^paho-mqtt/",
        "/^pika/",
        "/^httpx/"
      ],
      "groupName": "transport stack"
    },
    {
      "matchPackageNames": [
        "/^pytest/",
        "/^ruff/",
        "/^mypy/",
        "/^bandit/"
      ],
      "groupName": "dev tooling"
    },
    {
      "matchPackageNames": [
        "/^pytest/",
        "/^ruff/",
        "/^mypy/",
        "/^bandit/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  }
}
